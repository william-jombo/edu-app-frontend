# C:\Users\BR\Desktop\calmtech\frontend\edu-app-frontend\edu-app\.env

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================
# For React/Vite Application (edu-app)

# ============================================
# API CONFIGURATION
# ============================================

# Backend API URL - Points to Fly.io backend
VITE_API_URL=https://edu-app-backend.fly.dev
VITE_API_URL=https://edu-app-rose.vercel.app

# Use Proxy Mode
# false = Use absolute URLs (direct API calls to Fly.io)
VITE_USE_PROXY=false

# ============================================
# APPLICATION SETTINGS
# ============================================

VITE_APP_NAME=Edu-App
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Education Management System

# ============================================
# FEATURE FLAGS
# ============================================

# Enable debug mode (shows console logs, error details)
VITE_ENABLE_DEBUG=false

# Enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# Enable service worker (PWA)
VITE_ENABLE_PWA=false

# ============================================
# FILE UPLOAD SETTINGS
# ============================================

# Maximum file size in MB
VITE_MAX_FILE_SIZE=10

# Allowed file types (comma-separated)
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,mp4

# ============================================
# UI/UX SETTINGS
# ============================================

# Default theme (light, dark, auto)
VITE_DEFAULT_THEME=light

# Items per page in tables
VITE_ITEMS_PER_PAGE=10

# Session timeout warning (seconds before expiry)
VITE_SESSION_WARNING_TIME=300

# ============================================
# VERCEL CLI TOKEN (Auto-generated)
